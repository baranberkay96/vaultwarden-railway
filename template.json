{
  "name": "Vaultwarden 1.37 Password Manager",
  "description": "Bitwarden-compatible password vault with Postgres and encrypted backups",
  "category": "Authentication",
  "tags": [
    "vaultwarden",
    "password-manager",
    "bitwarden-compatible",
    "self-hosted",
    "backups",
    "security",
    "postgres",
    "2fa"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/vaultwarden.svg",
  "upstream": {
    "vaultwarden": "vaultwarden/server:1.37.5-alpine@sha256:bbe684a02d6b0db54256ff88eac9754f4519284a7b26314afc241fd7d0918191 (Vaultwarden 1.37.5, released 2026-11-01)",
    "postgres": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863 (= :18, checked 2026-11-20)",
    "license": "Vaultwarden: AGPL-3.0-only",
    "checked": "2026-11-20"
  },
  "services": {
    "Vaultwarden": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/vaultwarden.svg",
      "source": {
        "repo": "baranberkay96/vaultwarden-railway",
        "rootDirectory": "/services/vaultwarden"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/alive",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Railway's healthcheck and domain use (keep equal to ROCKET_PORT).",
          "required": true
        },
        "ROCKET_PORT": {
          "defaultValue": "8080",
          "description": "Port Vaultwarden listens on.",
          "required": true
        },
        "DOMAIN": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of the vault (used in e-mails, WebAuthn/passkeys and attachments). Update it when you add a custom domain.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Postgres connection URL on the private network.",
          "required": true
        },
        "ADMIN_TOKEN": {
          "defaultValue": "${{secret(48)}}",
          "description": "Password of the /admin panel. Hashed with argon2id at boot; an argon2 PHC string ($argon2id$...) is also accepted. Empty or < 12 chars disables /admin.",
          "required": true
        },
        "SIGNUPS_ALLOWED": {
          "defaultValue": "false",
          "description": "false = only invited e-mails can create accounts (invite them in /admin). true opens sign-up to anyone who finds the URL.",
          "required": false
        },
        "INVITATIONS_ALLOWED": {
          "defaultValue": "true",
          "description": "Let admins and organization owners invite users. Without SMTP, invited people register on the start page with the invited e-mail.",
          "required": false
        },
        "SIGNUPS_DOMAINS_WHITELIST": {
          "defaultValue": "",
          "description": "Optional: comma-separated e-mail domains that may sign up without an invitation (e.g. example.com).",
          "required": false
        },
        "SIGNUPS_VERIFY": {
          "defaultValue": "false",
          "description": "Require e-mail verification before login (needs SMTP).",
          "required": false
        },
        "SHOW_PASSWORD_HINT": {
          "defaultValue": "false",
          "description": "Never show password hints on the login page.",
          "required": false
        },
        "DB_CONNECTION_RETRIES": {
          "defaultValue": "0",
          "description": "0 = keep retrying the database at startup while Postgres boots.",
          "required": false
        },
        "DATABASE_MAX_CONNS": {
          "defaultValue": "10",
          "description": "Maximum Postgres connections.",
          "required": false
        },
        "LOG_LEVEL": {
          "defaultValue": "info",
          "description": "Log level (error, warn, info, debug).",
          "required": false
        },
        "SMTP_HOST": {
          "defaultValue": "",
          "description": "Optional SMTP server for invitations, 2FA e-mail and alerts. Outbound SMTP needs Railway Pro (see README).",
          "required": false
        },
        "SMTP_FROM": {
          "defaultValue": "",
          "description": "Optional sender address for e-mails (e.g. vault@example.com).",
          "required": false
        },
        "SMTP_PORT": {
          "defaultValue": "587",
          "description": "SMTP port.",
          "required": false
        },
        "SMTP_SECURITY": {
          "defaultValue": "starttls",
          "description": "starttls, force_tls or off.",
          "required": false
        },
        "SMTP_USERNAME": {
          "defaultValue": "",
          "description": "Optional SMTP user name.",
          "required": false
        },
        "SMTP_PASSWORD": {
          "defaultValue": "",
          "description": "Optional SMTP password.",
          "required": false
        },
        "PUSH_ENABLED": {
          "defaultValue": "false",
          "description": "true + PUSH_INSTALLATION_ID/KEY from bitwarden.com/host for mobile push sync.",
          "required": false
        },
        "PUSH_INSTALLATION_ID": {
          "defaultValue": "",
          "description": "Optional: installation id from https://bitwarden.com/host.",
          "required": false
        },
        "PUSH_INSTALLATION_KEY": {
          "defaultValue": "",
          "description": "Optional: installation key from https://bitwarden.com/host.",
          "required": false
        },
        "BACKUP_ENABLED": {
          "defaultValue": "true",
          "description": "Daily encrypted backup of the database and /data to the Railway Bucket.",
          "required": false
        },
        "BACKUP_TIME": {
          "defaultValue": "03:15",
          "description": "Time of the daily backup, HH:MM in UTC.",
          "required": false
        },
        "BACKUP_ON_START": {
          "defaultValue": "false",
          "description": "true = also run a backup about one minute after each boot (handy to test the backup).",
          "required": false
        },
        "BACKUP_ENCRYPTION_PASSPHRASE": {
          "defaultValue": "${{secret(48)}}",
          "description": "gpg passphrase of the backups (AES-256). Keep a copy outside Railway: without it the backups cannot be decrypted.",
          "required": true
        },
        "BACKUP_S3_BUCKET": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Railway Bucket that stores the backups.",
          "required": false
        },
        "BACKUP_S3_ENDPOINT": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Bucket S3 endpoint.",
          "required": false
        },
        "BACKUP_S3_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Bucket region.",
          "required": false
        },
        "BACKUP_S3_ACCESS_KEY_ID": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Bucket access key.",
          "required": false
        },
        "BACKUP_S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key.",
          "required": false
        },
        "BACKUP_PREFIX": {
          "defaultValue": "vaultwarden",
          "description": "Folder in the bucket; each run writes {prefix}/{UTC timestamp}/vaultwarden.tar.gpg and MANIFEST.txt.",
          "required": false
        },
        "BACKUP_RETENTION_DAYS": {
          "defaultValue": "30",
          "description": "Delete complete runs older than this many days.",
          "required": false
        },
        "BACKUP_KEEP_MIN": {
          "defaultValue": "3",
          "description": "Always keep at least this many complete runs, whatever their age.",
          "required": false
        },
        "BACKUP_RESTORE_RUN": {
          "defaultValue": "",
          "description": "One-shot restore at boot: latest or a run folder (e.g. 20261120T031500Z). Replaces the database and /data. Needs BACKUP_RESTORE_CONFIRM.",
          "required": false
        },
        "BACKUP_RESTORE_CONFIRM": {
          "defaultValue": "",
          "description": "Must equal BACKUP_RESTORE_RUN to confirm the restore. Clear both afterwards.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "15",
          "description": "Seconds Vaultwarden gets to finish requests on redeploy.",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18.6@sha256:4fc833b43d2aaf6ecc9b18615f5533602b723a32d0e2efe2dae8ca0f7217c863"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database is initialized (inside the volume).",
          "required": true
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private hostname of the database.",
          "required": true
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": true
        },
        "PGUSER": {
          "defaultValue": "${{POSTGRES_USER}}",
          "description": "User for the Railway Data panel.",
          "required": true
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Database for the Railway Data panel.",
          "required": true
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Password for the Railway Data panel.",
          "required": true
        },
        "POSTGRES_DB": {
          "defaultValue": "vaultwarden",
          "description": "Database created on the first boot (Vaultwarden's database).",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "Database superuser.",
          "required": true
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Database password, generated at deploy.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "Private connection URL.",
          "required": true
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "Validity of the self-signed TLS certificate in days.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Seconds Postgres gets to shut down cleanly on redeploy.",
          "required": true
        }
      }
    }
  },
  "buckets": [
    "Bucket"
  ]
}